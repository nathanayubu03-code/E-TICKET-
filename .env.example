# e-Ticket RDC · variables d'environnement
# Copier en .env pour le développement local. Aucune vraie valeur ici.
# En production (Vercel), saisir ces variables dans Project Settings > Environment Variables.

# ---------------------------------------------------------------------------
# Base de données (PostgreSQL ; Neon en production)
# ---------------------------------------------------------------------------
# Connexion de l'application. Sur Neon : l'URL « poolée » (hôte contenant -pooler), avec ?sslmode=require.
DATABASE_URL=postgresql://utilisateur:motdepasse@localhost:5432/eticket
# Connexion directe pour les migrations (Neon : même URL sans -pooler). Facultatif en local.
DIRECT_URL=

# Environnement fonctionnel : development, test, preview ou production.
# production interdit la simulation de paiement et de SMS (l'application refuse de démarrer).
APP_ENV=development

# Adresse publique du site, sans barre finale (liens envoyés par SMS). Ex. : https://www.exemple.cd
NEXT_PUBLIC_SITE_URL=

# ---------------------------------------------------------------------------
# Secrets (générer des valeurs aléatoires, jamais les mêmes entre environnements)
# ---------------------------------------------------------------------------
# 32 caractères minimum. Signe les sessions et hache les codes OTP. Le changer déconnecte tout le monde.
# Générer : openssl rand -hex 32
SESSION_SECRET=
# Clé AES-256 en base64 (32 octets) : chiffre les numéros de reversement des organisateurs.
# Générer : openssl rand -base64 32   (la changer rend illisibles les numéros déjà enregistrés)
ENCRYPTION_KEY=
# 24 caractères minimum. Protège les routes planifiées (/api/cron/...). Vercel Cron l'envoie tout seul.
# Générer : openssl rand -hex 24
CRON_SECRET=

# ---------------------------------------------------------------------------
# Paiement Mobile Money
# ---------------------------------------------------------------------------
# simulation : développement uniquement (interdit en production).
# non_configure : aucun paiement en ligne (le paiement chez un agent reste possible).
# Valeur de l'agrégateur retenu : à ajouter avec son adaptateur (voir docs/paiement.md).
PAYMENT_PROVIDER=simulation
# Secret de signature des webhooks de la simulation (développement).
SIMULATION_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# SMS
# ---------------------------------------------------------------------------
# simulation : développement uniquement (écrit dans le journal SmsLog et la console, n'envoie rien).
# non_configure : aucun SMS (les connexions par code sont alors impossibles).
SMS_PROVIDER=simulation

# ---------------------------------------------------------------------------
# Stockage des affiches
# ---------------------------------------------------------------------------
# local (développement, dossier STORAGE_LOCAL_DIR) ou s3 (production : Cloudflare R2).
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=stockage-local
# Cloudflare R2 : https://<ID_COMPTE>.r2.cloudflarestorage.com
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# URL publique du bucket (domaine personnalisé R2 ou r2.dev), sans barre finale.
S3_PUBLIC_URL=

# ---------------------------------------------------------------------------
# Contacts affichés (vide : le bloc correspondant n'apparaît pas)
# ---------------------------------------------------------------------------
CONTACT_ORGANISATEURS_EMAIL=
CONTACT_ORGANISATEURS_TELEPHONE=
# Contact général (pages Conditions et Confidentialité).
CONTACT_EMAIL=

# Mentions de l'éditeur (pages Conditions et Confidentialité ; rien n'est affiché si EDITEUR_NOM est vide).
EDITEUR_NOM=
EDITEUR_FORME=
EDITEUR_RCCM=
EDITEUR_ADRESSE=

# ---------------------------------------------------------------------------
# Seed de production (npm run db:seed) : création du super-administrateur
# ---------------------------------------------------------------------------
# Numéro au format +243XXXXXXXXX ; il reçoit le code SMS de connexion.
SUPERADMIN_TELEPHONE=
# 12 caractères minimum, avec lettres et chiffres. À retirer des variables après le premier seed.
SUPERADMIN_MOT_DE_PASSE=
SUPERADMIN_NOM=

# ---------------------------------------------------------------------------
# Tests (facultatif)
# ---------------------------------------------------------------------------
# TEST_DATABASE_URL=postgresql://utilisateur:motdepasse@localhost:5432/eticket_test
# E2E_DATABASE_URL=postgresql://utilisateur:motdepasse@localhost:5432/eticket_e2e
